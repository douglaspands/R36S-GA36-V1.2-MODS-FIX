[Unit]
Description=Sincroniza ClassiCube e capa no menu Ports (R36S)
# Sem After=emuelec-autostart.service: o autostart só termina depois do
# "systemctl start emustation", e esperar por ele trava o boot no splash.
# O script espera o mount_romfs.sh montar /storage/roms.
Before=emustation.service

[Service]
Type=oneshot
ExecStart=/usr/lib/r36/classicube-sync
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=emuelec.target
