#!/bin/sh
# Ajustes do RetroArch no boot, na p8:
#  1. Pastas do retroarch.cfg. A imagem de fábrica aponta rgui_config_directory,
#     savefile_directory, log_dir e osk_overlay_directory para /config, /saves, /logs e
#     /overlays/keyboards, que não existem numa raiz somente leitura (salvar opções de core,
#     override ou preset pelo menu dá erro). Cada chave é trocada só se a linha ainda for a
#     de fábrica, no mesmo arquivo; um valor diferente (escolha do usuário) fica como está.
#  2. gpSP.opt: acrescenta gpsp_boot_mode = "bios" (Boot to BIOS) e gpsp_frame_mixing = "enabled" (interframe blending, o ghosting do
#     LCD) se a chave não existir; um valor existente não é alterado. Com o arquivo vazio
#     r36-gpsp-sem-ghost na raiz da p1, remove só a linha "enabled".
#  3. Save states e hardware ausente no retroarch.cfg, também só sobre a linha de fábrica:
#     sort_savestates_enable "false" (o RetroArch grava <rom>.state e a miniatura .png em
#     /storage/roms/savestates/<sistema>/, onde o ES procura), drivers de Wi-Fi, Bluetooth,
#     microfone e MIDI em "null" e os menus de rede, gravação, streaming e rewind ocultos.
#     Com a p1 montada, cria /storage/roms/savestates e move os *.state* das subpastas de
#     core (<sistema>/<core>/) para a pasta do sistema, sem sobrescrever o que já está lá.
# Com o arquivo vazio r36-diagnostico na raiz da p1, deixa o resultado em r36-retroarch.log.
# R36_ROOT fica vazio no aparelho; os testes apontam para um diretório temporário.

ROOT="${R36_ROOT:-}"
RADIR="$ROOT/storage/.config/retroarch"
RACFG="$RADIR/retroarch.cfg"
OPT="$RADIR/config/gpSP/gpSP.opt"
OFF="$ROOT/storage/roms/r36-gpsp-sem-ghost"
LOG="$ROOT/storage/roms/r36-retroarch.log"
DIAG="$ROOT/storage/roms/r36-diagnostico"
CHAVE='gpsp_frame_mixing'
LINHA='gpsp_frame_mixing = "enabled"'

# A chave fica na p1, que o mount_romfs.sh monta dentro do emuelec-autostart: espera a
# montagem (até 20 s) em vez de ordenar o serviço depois dele, o que trava o boot. Sem p1
# depois disso, segue sem chave: o blending fica ligado.
MONTADA=
if [ -z "$ROOT" ]; then
    i=0
    until mountpoint -q /storage/roms 2>/dev/null; do
        [ "$i" -ge 20 ] && break
        sleep 1
        i=$((i + 1))
    done
    mountpoint -q /storage/roms 2>/dev/null && MONTADA=sim
elif [ -d "$ROOT/storage/roms" ]; then
    MONTADA=sim
fi
LOGA=
[ -n "$MONTADA" ] && [ -e "$DIAG" ] && LOGA=sim
[ -n "$LOGA" ] && : > "$LOG"
registro() { [ -n "$LOGA" ] && printf '%s\n' "$1" >> "$LOG"; }
registro "r36-retroarch-prepara $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"

# 1. Pastas do retroarch.cfg
troca() { # chave valor-de-fábrica valor-novo
    if grep -qx "$1 = \"$2\"" "$RACFG"; then
        sed "s|^$1 = \"$2\"\$|$1 = \"$3\"|" "$RACFG" > "$RACFG.r36tmp" && cat "$RACFG.r36tmp" > "$RACFG"
        rm -f "$RACFG.r36tmp"
        registro "retroarch.cfg: $1 trocada de $2 para $3"
    fi
}
if [ -f "$RACFG" ]; then
    troca rgui_config_directory /config '~/.config/retroarch/config'
    troca savefile_directory /saves '~/savefiles'
    troca log_dir /logs '~/.config/emuelec/logs'
    troca osk_overlay_directory /overlays/keyboards '~/overlays/keyboards'
    registro "retroarch.cfg: $(grep -E '^(rgui_config_directory|savefile_directory|log_dir|osk_overlay_directory) ' "$RACFG" | tr '\n' ' ')"
    # 3. Save states na pasta do sistema, sem drivers de hardware ausente, menus enxutos
    troca sort_savestates_enable true false
    troca wifi_enabled true false
    troca wifi_driver connmanctl null
    troca bluetooth_driver bluetoothctl null
    troca microphone_driver alsathread null
    troca midi_driver alsa null
    troca menu_show_rewind true false
    troca menu_show_online_updater true false
    troca quick_menu_show_download_thumbnails true false
    troca quick_menu_show_start_recording true false
    troca quick_menu_show_start_streaming true false
    troca settings_show_network true false
    troca settings_show_achievements true false
    troca settings_show_ai_service true false
else
    registro "retroarch.cfg ausente"
fi

# 2. gpSP.opt
garante() { # chave valor: cria o arquivo ou acrescenta a linha só se a chave não existir
    if [ -f "$OPT" ]; then
        if grep -q "^$1[[:space:]]*=" "$OPT"; then
            registro "gpSP.opt: $1 ja existe ($(grep "^$1[[:space:]]*=" "$OPT" | head -1)), mantida"
        else
            # garante quebra de linha no fim antes de acrescentar
            [ -n "$(tail -c1 "$OPT")" ] && printf '\n' >> "$OPT"
            printf '%s = "%s"\n' "$1" "$2" >> "$OPT" && registro "gpSP.opt: $1 = \"$2\" acrescentada"
        fi
    elif mkdir -p "${OPT%/*}" && printf '%s = "%s"\n' "$1" "$2" > "$OPT"; then
        registro "gpSP.opt criado com $1 = \"$2\""
    fi
}
# Boot mode: o gpSP precisa iniciar pela BIOS (o jogo de GBA depende dela neste aparelho)
garante gpsp_boot_mode bios
if [ -e "$OFF" ]; then
    if [ -f "$OPT" ] && grep -qx "$LINHA" "$OPT"; then
        grep -vx "$LINHA" "$OPT" > "$OPT.r36tmp" && cat "$OPT.r36tmp" > "$OPT"
        rm -f "$OPT.r36tmp"
        registro "gpSP.opt: chave r36-gpsp-sem-ghost, $LINHA removida"
    else
        registro "gpSP.opt: chave r36-gpsp-sem-ghost, nada a remover"
    fi
else
    garante "$CHAVE" enabled
fi

# 3. Save states gravados com sort_savestates_enable "true" (<sistema>/<core>/) vão para a
# pasta do sistema. Só com a p1 montada: sem ela, /storage/roms é a pasta vazia da p8.
SAVES="$ROOT/storage/roms/savestates"
if [ -n "$MONTADA" ]; then
    mkdir -p "$SAVES"
    for arq in "$SAVES"/*/*/*.state*; do
        [ -f "$arq" ] || continue
        sub="${arq%/*}"
        dest="${sub%/*}/${arq##*/}"
        if [ -e "$dest" ]; then
            registro "savestates: ${arq#"$SAVES"/} mantido, ja existe ${dest#"$SAVES"/}"
        elif mv "$arq" "$dest"; then
            registro "savestates: ${arq#"$SAVES"/} movido para ${dest#"$SAVES"/}"
            rmdir "$sub" 2>/dev/null  # só sai quando fica vazia
        fi
    done
fi

# 4. Atualiza o catálogo de tradução do EmulationStation na p8 se o SYSTEM tiver versão mais nova
if [ -d "$ROOT/usr/config/emuelec/configs/locale" ] && [ -d "$ROOT/storage/.config/emuelec/configs/locale" ]; then
    for ldir in "$ROOT/usr/config/emuelec/configs/locale"/*; do
        [ -d "$ldir" ] || continue
        lang="${ldir##*/}"
        src_mo="$ldir/LC_MESSAGES/emulationstation2.mo"
        dst_dir="$ROOT/storage/.config/emuelec/configs/locale/$lang/LC_MESSAGES"
        if [ -f "$src_mo" ]; then
            mkdir -p "$dst_dir" 2>/dev/null
            cp -f "$src_mo" "$dst_dir/emulationstation2.mo" 2>/dev/null
        fi
    done
fi

exit 0
