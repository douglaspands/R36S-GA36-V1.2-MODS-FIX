<theme>
<formatVersion>7</formatVersion>

  	<variables>
		<controllerSubsetName>Show controllers in system view</controllerSubsetName>
	</variables>
	<subset name="language" displayName="${languageSubsetName}">
        <include name="pt-br" displayName="Português (Brasil)">./_languages/pt-br.xml</include>
        <include name="es-latam" displayName="Español (Latino)">./_languages/es-latam.xml</include>
        <include name="en" displayName="English">./_languages/en.xml</include>
    </subset>


	
	<subset name="controller" displayName="${controllerSubsetName}">
        <include name="on" displayName="${on}"/>
        <include name="off" displayName="${off}">./_art/settings/controllers.xml</include>
    </subset>

<view name="system">
    <image name="background" extra="true">
        <path>./_art/var/dot.png</path>
        <tile>false</tile>
        <size>1 1</size>
        <pos>0 0</pos>
        <origin>0 0</origin>
    </image>

      <sound name="bgsound">
         <!-- try ogg -->
         <path>./_art/assets/sounds/${system.theme}.ogg</path>
         <!-- try mp3 -->
         <path>./_art/assets/sounds/${system.theme}.mp3</path>
      </sound>
   
    <image name="poster" extra="true">
        <path>./_art/posters/${system.theme}.jpg</path>
        <path>./_art/posters/${system.theme}.png</path>
        <tile>false</tile>
        <origin>1 0</origin>
        <pos>1 0</pos>
        <size>0 1</size>
    </image>

    <carousel name="systemcarousel">
        <type>vertical</type>
        <color>00000000</color>
        <origin>1 1</origin>
        <pos>1 1</pos>
        <size>0.01 0.01</size>
        <logoScale>1</logoScale>
        <logoSize>0.01 0.01</logoSize>
        <maxLogoCount>0</maxLogoCount>
    </carousel>
    
        <text name="shortdescription" extra="true">
        <fontPath>./_art/Acre.otf</fontPath>
        <alignment>left</alignment>
        <forceUppercase>0</forceUppercase>
        <fontSize>0.022</fontSize>
        <color>ffffff</color>
        <origin>0 0</origin>
        <pos>0.025 0.080</pos>
        <size>0.320 0.025</size>
    </text>

    <text name="sys_line1" extra="true">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <alignment>left</alignment>
        <forceUppercase>1</forceUppercase>
        <color>FFFFFF</color>
        <fontSize>0.045</fontSize>
        <origin>0 0</origin>
        <pos>0.025 0.115</pos>
        <size>0.975 0.045</size>
    </text>
    
    <text name="sys_line2" extra="true">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <alignment>left</alignment>
        <forceUppercase>1</forceUppercase>
        <fontSize>0.130</fontSize>
        <origin>0 0</origin>
        <pos>0.025 0.160</pos>
        <size>0.975 0.200</size>
        <color>FFFFFF</color>
    </text>

    <image name="buttonA" extra="true">
        <path>${buttonImage}</path>
        <path>./_art/var/button.svg</path>
        <tile>false</tile>
        <origin>0 0</origin>
        <pos>0.025 0.460</pos>
        <size>0 0.085</size>
        <color>585858</color>
    </image>

    <text name="systemInfo">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <alignment>left</alignment>
        <backgroundColor>00000000</backgroundColor>
        <forceUppercase>1</forceUppercase>
        <color>FFAE00</color>
        <origin>0 0</origin>
        <pos>0.025 0.570</pos>
        <size>0.400 0.042</size>
        <fontSize>0.050</fontSize>
    </text>
    
    <text name="longdescription" extra="true">
        <fontPath>./_art/Acre.otf</fontPath>
        <alignment>left</alignment>
        <forceUppercase>0</forceUppercase>
        <fontSize>0.022</fontSize>
        <color>ffffff</color>
        <lineSpacing>1.18</lineSpacing>
        <origin>0 0</origin>
        <pos>0.025 0.660</pos>
        <size>0.30 0.26</size>
    </text>

    <image name="controller" extra="true">
        <path>./_art/controllers/${system.theme}.png</path>
        <tile>false</tile>
        <origin>0 0</origin>
        <pos>0.35 0.62</pos>
        <maxSize>0.28 0.28</maxSize>
    </image>

    <helpsystem name="help">
        <fontPath>./_art/Acre.otf</fontPath>
        <fontSize>0.022</fontSize>
        <textColor>A0A0A0</textColor>
        <iconColor>FFAE00</iconColor>
        <pos>0.025 0.965</pos>
        <origin>0 1</origin>
    </helpsystem>
</view>

<view name="basic, detailed, video, grid">

    <image name="background" extra="true">
        <tile>false</tile>
        <path>./_art/ingame-global-bg.png</path>
        <size>1 1</size>
        <pos>0 0</pos>
    </image>

    <textlist name="gamelist">
        <selectorColor>1c1c1c</selectorColor>
        <selectedColor>FFAE00</selectedColor>
        <selectorHeight>0.06</selectorHeight>
        <primaryColor>585858</primaryColor>
        <secondaryColor>888888</secondaryColor>
        <fontPath>./_art/Acre.otf</fontPath>
        <alignment>left</alignment>
        <pos>0 0.12</pos>
	    <size>0.319 0.805</size>
        <fontSize>0.03</fontSize>
        <lineSpacing>1.683</lineSpacing>
        <horizontalMargin>0.025</horizontalMargin>
    </textlist>
	
	<helpsystem name="help">
        <fontPath>./_art/Acre.otf</fontPath>
        <fontSize>0.022</fontSize>
        <textColor>A0A0A0</textColor>
        <iconColor>FFAE00</iconColor>
        <pos>0.025 0.965</pos>
	    <origin>0 1</origin>
    </helpsystem>
    
    <text name="top_label" extra="true">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <text>${top_label}</text>
        <alignment>left</alignment>
        <color>F8F8F8</color>
        <fontSize>0.050</fontSize>
        <origin>0 0</origin>
        <pos>0.025 0.025</pos>
        <size>0.28 0.08</size>
    </text>
    
    <text name="nameLabel" extra="true">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <alignment>left</alignment>
        <forceUppercase>1</forceUppercase>
        <color>FFAE00</color>
        <fontSize>0.050</fontSize>
        <origin>0 0</origin>
        <pos>0.339 0.025</pos>
        <size>0.64 0.08</size>
        <zIndex>50</zIndex>
    </text>

    <image name="md_image">
        <tile>false</tile>
        <origin>0.5 0.5</origin>
        <pos>0.66 0.485</pos>
        <maxSize>0.62 0.70</maxSize>
    </image>

    <video name="md_video">
        <origin>0.5 0.5</origin>
        <pos>0.66 0.485</pos>
        <maxSize>0.62 0.70</maxSize>
        <delay>1.4</delay>
        <showSnapshotNoVideo>true</showSnapshotNoVideo>
        <showSnapshotDelay>true</showSnapshotDelay>
    </video>
    
    <text name="md_name">
        <fontPath>./_art/BebasNeue.otf</fontPath>
        <alignment>left</alignment>
        <color>FFFFFF</color>
        <fontSize>0.045</fontSize>
        <origin>0 0</origin>
        <pos>0.339 0.865</pos>
        <size>0.64 0.06</size>
        <zIndex>50</zIndex>
        <singleLineScroll>true</singleLineScroll>
    </text>

    <image name="md_marquee">
        <pos>0.6598958333333333 0.220</pos>
        <origin>0.5 0.5</origin>
        <maxSize>0.300 0.180</maxSize>
    </image>

    <text name="txt_descript" extra="true">
        <text></text>
        <fontPath>./_art/Acre.otf</fontPath>
        <alignment>left</alignment>
        <fontSize>0.02</fontSize>
        <color>FFAE00</color>
        <origin>0 0</origin>
        <pos>0.339 0.630</pos>
        <size>0.06 0.2</size>
    </text> 
        
    <!-- Hidden Elements -->
    <text name="shortdescription, longdescription" extra="true">
        <origin>1 1</origin>
        <pos>0 0</pos>
        <color>00000000</color>
    </text>
        
    <text name="md_lbl_releasedate, md_lbl_developer, md_developer, md_lbl_playcount, md_playcount, md_lbl_lastplayed, md_lbl_publisher, md_publsher">
        <origin>1 1</origin>
        <color>00000000</color>
        <pos>0 0</pos>
    </text>

    <datetime name="md_releasedate, md_lastplayed">
        <origin>1 1</origin>
        <color>00000000</color>
        <pos>0 0</pos>
    </datetime>
        
</view>

   <view name="screen">
    <text name="clock">
      <color>FFFFFF</color>
      <fontSize>0.035</fontSize>
      <pos>0.910 0.01</pos>
      <size>0.09 0.058</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
    </text>
    <batteryIndicator name="batteryIndicator">
      <pos>0.855 0.01</pos>
      <size>0.033 0.033</size>
      <incharge>./art/battery/incharge.svg</incharge>
      <full>./art/battery/full.svg</full>
      <at75>./art/battery/75.svg</at75>
      <at50>./art/battery/50.svg</at50>
      <at25>./art/battery/25.svg</at25>
      <empty>./art/battery/empty.svg</empty>
      <color>FFFFFFA0</color>
    </batteryIndicator>
    <batteryIndicator name="batteryIndicator" tinyScreen="true">
      <pos>0.915 0.013</pos>
      <size>0.07 0.07</size>
    </batteryIndicator>
  </view>
	
  <view name="menu">
    <menuBackground name="menubg">
      <color>202020</color>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>./_art/BebasNeue.otf</fontPath>
      <fontSize>0.038</fontSize>
      <color>FFAE00</color>
      <alignment>left</alignment>
    </menuText>
    <menuText name="menutext">
      <fontPath>./_art/Acre.otf</fontPath>
      <fontSize>0.030</fontSize>
      <color>FFAE00</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>./_art/Acre.otf</fontPath>
      <fontSize>0.022</fontSize>
      <color>A0A0A0</color>
    </menuText>
    <menuText name="menutextsmall">
      <fontPath>./_art/Acre.otf</fontPath>
      <fontSize>0.028</fontSize>
      <color>888888</color>
    </menuText>
    <menuTextEdit name="menutextedit">
      <inactive>./_art/assets/textinput_inactive.png</inactive>
      <active>./_art/assets/textinput_active.png</active>
    </menuTextEdit>
  </view>
	
</theme>
