<theme>
  <formatVersion>7</formatVersion>
  <include>./../theme.xml</include>
  <view name="basic, detailed, video, grid">
    <text name="nameLabel" extra="true">
      <text>${action.nameLabel}</text>
    </text>
  </view>
  <view name="system">
    <text name="sys_line1" extra="true">
      <text>${action.sys_line1}</text>
    </text>
    <text name="sys_line2" extra="true">
      <text>${action.sys_line2}</text>
      <fontSize>0.18</fontSize>
      <origin>0 0</origin>
      <pos>0.12 0.130</pos>
      <size>0 0</size>
    </text>
    <text name="shortdescription" extra="true">
      <text>${action.shortdescription}</text>
    </text>
    <text name="longdescription" extra="true">
      <text>${action.longdescription}</text>
    </text>
  </view>
</theme>
