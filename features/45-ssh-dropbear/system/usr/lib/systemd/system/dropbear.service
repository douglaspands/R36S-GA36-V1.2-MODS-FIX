[Unit]
Description=Dropbear SSH server
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStartPre=/usr/lib/r36/dropbear-setup
ExecStart=/usr/sbin/dropbear -F -E -r /storage/.cache/ssh/dropbear_ed25519_host_key -r /storage/.cache/ssh/dropbear_rsa_host_key -p 22
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
