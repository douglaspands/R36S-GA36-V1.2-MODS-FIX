#!/bin/sh
# Inicialização e preparação de chaves do Dropbear SSH.
# Assegura o diretório persistente /storage/.cache/ssh e gera chaves de host se não existirem.

set -e

KEY_DIR="/storage/.cache/ssh"
ED25519_KEY="$KEY_DIR/dropbear_ed25519_host_key"
RSA_KEY="$KEY_DIR/dropbear_rsa_host_key"
DROPBEARKEY="/usr/sbin/dropbearkey"

# Se /usr/sbin/dropbearkey não existir, tenta /usr/bin/dropbearkey
if [ ! -x "$DROPBEARKEY" ]; then
    DROPBEARKEY="/usr/bin/dropbearkey"
fi

mkdir -p "$KEY_DIR"
chmod 0700 "$KEY_DIR"

if [ ! -s "$ED25519_KEY" ]; then
    echo "Gerando chave de host Dropbear Ed25519 em $ED25519_KEY..."
    "$DROPBEARKEY" -t ed25519 -f "$ED25519_KEY"
    chmod 0600 "$ED25519_KEY"
fi

if [ ! -s "$RSA_KEY" ]; then
    echo "Gerando chave de host Dropbear RSA (2048 bits) em $RSA_KEY..."
    "$DROPBEARKEY" -t rsa -s 2048 -f "$RSA_KEY"
    chmod 0600 "$RSA_KEY"
fi

exit 0
